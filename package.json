{
  "name": "projeto-psi",
  "version": "1.0.0",
  "description": "Plataforma Inteligente para Psicólogos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
