# Database (Supabase Integration)
# DATABASE_URL: Transaction Pooler connection string (Port 6543) - e.g., postgres://postgres.[org]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="sua_string_de_pooling_do_supabase"
# DIRECT_URL: Direct Connection string (Port 5432) - e.g., postgres://postgres:[pwd]@aws-0-[region].db.supabase.com:5432/postgres
DIRECT_URL="sua_string_de_conexao_direta_do_supabase"

# Auth
JWT_SECRET="sua_chave_secreta_aqui"

# AI (OpenAI)
OPENAI_API_KEY="sua_api_key_aqui"

# WhatsApp (Evolution API)
WHATSAPP_API_URL="sua_api_url_aqui"
WHATSAPP_API_KEY="sua_api_key_aqui"
